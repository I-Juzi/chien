<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.juzi.chien.admin.mapper.SysUserMapper">

    <!-- 根据角色ID查询用户列表 -->
    <select id="selectUsersByRoleId" resultType="com.juzi.chien.admin.domain.entity.SysUser">
        SELECT u.*
        FROM `chien-user` u
        INNER JOIN `chien-user_role` ur ON u.id = ur.user_id
        WHERE ur.role_id = #{roleId} AND u.deleted = 0
    </select>

</mapper>
